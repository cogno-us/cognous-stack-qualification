{
 "kind": "verifier-mutation-witness-seed-map",
 "catalogue_version": "3",
 "what": "which family H category each ODES witness-digest and holder-inventory invalid fixture seeds (catalogue version 3; regression only, never detection). Classified by the design's category definitions (INDEPENDENT-VERIFIER-DESIGN.md section 4.3, family H) and its seed column; written after the verifier's tier V3 existed (post-hoc). Fixtures not listed are counted as unclassified, never dropped.",
 "unclassified_on_purpose": {
  "witness-digest/empty-witness-file": "H8 control (expected abstain): a seed row reports refusal with the intended code, which an abstain-expected control cannot have; its observed verdict is reported in the harness extension instead"
 },
 "carrier": {
  "witness-digest": "staged-two-records-chained",
  "holder-inventory": "run-with-holder-inventory-journal-mode",
  "why": "witness fixtures without a record are run with the record of the capture they were mutated from; holder-inventory fixtures carry no record or witness, so they are run with the record and witness of the captured run that held an inventory"
 },
