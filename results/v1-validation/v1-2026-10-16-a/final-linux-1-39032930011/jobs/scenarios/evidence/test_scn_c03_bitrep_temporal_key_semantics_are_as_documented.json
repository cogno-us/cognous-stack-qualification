        "revocation": "now >= revoked_at rejects every signature of the key, including earlier statements",
        "snapshot": "[published_at, valid_until) else fail closed",
        "statement": "issued_at/not_before <= now < expires_at, no skew"
      },
      "temporal_key_semantics": [
        {
          "expected": [
            "verified",
            "ok"
          ],
          "label": "key revoked one second in the future (not yet in force)",
          "now_offset": 0,
          "outcome": "verified",
          "reason": "ok"
        },
        {
          "expected": [
            "rejected",
            "key_revoked"
          ],
          "label": "revoked_at == now (inclusive)",
          "now_offset": 0,
          "outcome": "rejected",
          "reason": "key_revoked"
        },
        {
          "expected": [
            "rejected",
            "key_revoked"
          ],
          "label": "revoked_at in the past, statement issued earlier (no grandfathering, not backdatable)",
          "now_offset": 0,
          "outcome": "rejected",
          "reason": "key_revoked"
        },
        {
          "expected": [
            "rejected",
            "key_expired"
          ],
          "label": "key valid_until == now (half-open: expired)",
          "now_offset": 0,
          "outcome": "rejected",
          "reason": "key_expired"
        },
        {
          "expected": [
            "verified",
            "ok"
          ],
          "label": "key valid_until == now+1 (still valid)",
          "now_offset": 0,
          "outcome": "verified",
          "reason": "ok"
        },
        {
          "expected": [
            "rejected",
            "key_not_yet_valid"
          ],
          "label": "key valid_from == now+1 (not yet valid)",
          "now_offset": 0,
          "outcome": "rejected",
          "reason": "key_not_yet_valid"
        },
        {
          "expected": [
            "rejected",
            "issuance_outside_key_validity"
          ],
          "label": "key valid_from == now (inclusive start; issuance precedes it)",
          "now_offset": 0,
          "outcome": "rejected",
          "reason": "issuance_outside_key_validity"
        },
        {
          "expected": [
            "verified",
            "ok"
          ],
          "label": "statement expires_at - 1 (still valid; no skew allowance)",
          "now_offset": 99,
          "outcome": "verified",
          "reason": "ok"
        },
        {
          "expected": [
            "rejected",
            "attestation_expired"
          ],
          "label": "statement expires_at == now (half-open: expired)",
          "now_offset": 100,
          "outcome": "rejected",
          "reason": "attestation_expired"
        },
        {
          "expected": [
            "rejected",
            "not_yet_valid"
          ],
          "label": "issued one second after now (no clock-skew allowance)",
          "now_offset": 0,
          "outcome": "rejected",
          "reason": "not_yet_valid"
        },
        {
          "expected": [
            "rejected",
            "key_expired"
          ],
          "label": "rotation: statement valid at issuance, old key retired at evaluation",
          "now_offset": 0,
          "outcome": "rejected",
          "reason": "key_expired"
        },
        {
          "expected": [
            "rejected",
            "issuance_outside_key_validity"
          ],
          "label": "rotation: new key signs for a time before its validity",
          "now_offset": 0,
          "outcome": "rejected",
          "reason": "issuance_outside_key_validity"
        },
        {
          "expected": [
            "verified",
            "ok"
          ],
          "label": "rotation: new key, current statement",
          "now_offset": 0,
          "outcome": "verified",
          "reason": "ok"
        },
        {
          "expected": [
            "rejected",
            "invalid_signature"
          ],
          "label": "rotation: retired key signature presented under the new key id",
          "now_offset": 0,
          "outcome": "rejected",
          "reason": "invalid_signature"
        },
        {
          "expected": [
            "verified",
            "ok"
          ],
          "label": "trust snapshot published_at == now (inclusive)",
          "now_offset": 0,
          "outcome": "verified",
          "reason": "ok"
        },
        {
          "expected": [
            "unavailable",
            "trust_unavailable"
          ],
          "label": "trust snapshot published in the future (fails closed)",
          "now_offset": 0,
          "outcome": "unavailable",
          "reason": "trust_unavailable"
        },
        {
          "expected": [
            "unavailable",
            "trust_unavailable"
          ],
          "label": "trust snapshot valid_until == now (exclusive; fails closed)",
          "now_offset": 0,
          "outcome": "unavailable",
          "reason": "trust_unavailable"
        }
      ]
    },
