          "now_offset": 0,
          "outcome": "rejected",
          "reason": "key_revoked"
        },
        {
          "expected": [
            "rejected",
            "key_revoked"
          ],
          "label": "revoked_at in the past, statement issued earlier (no grandfathering, not backdatable)",
