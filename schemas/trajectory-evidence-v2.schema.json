{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded local trajectory evidence v2",
  "description": "Named local assertion evidence only. Semantic validator and frozen plan are mandatory; no catalog promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "observed_at",
    "sources",
    "profile",
    "plan_sha256",
    "environment",
    "cases",
    "calibration",
    "artifacts",
    "assurance",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "record_kind": {
      "const": "bounded-local-trajectory"
    },
    "observed_at": {
      "type": "string"
    },
    "sources": {
      "type": "object",
      "required": [
        "hub",
        "qualification"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "repository",
          "commit",
          "dirty",
          "files"
        ],
        "properties": {
          "repository": {
            "type": "string"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "dirty": {
            "const": false
          },
          "files": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "selected",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "selected": {
          "const": false
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment": {
      "type": "object"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "variant",
          "trial",
          "scenario_id",
          "scenario_sha256",
          "provenance",
          "license",
          "execution",
          "initial_business_digest",
          "reset_verified",
          "responses",
          "attempts",
          "events",
          "observation",
          "result",
          "verdict_scope"
        ],
        "properties": {
          "scenario_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "trial": {
            "type": "integer",
            "minimum": 1
          },
          "reset_verified": {
            "const": true
          },
          "result": {
            "type": "object",
            "required": [
              "verdict",
              "failures",
              "missing"
            ],
            "properties": {
              "verdict": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "INCONCLUSIVE",
                  "NOT RUN",
                  "NOT APPLICABLE"
                ]
              },
              "failures": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "missing": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "calibration": {
      "type": "object"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "assurance": {
      "const": {
        "release_authorized": false,
        "production_authorized": false,
        "human_oversight": "NOT EVALUATED"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
