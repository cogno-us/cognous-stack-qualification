    {
      "id": "NC2-02",
      "mandatory": true,
      "title": "No blind retry: re-execution of the same claim is refused (status denied, not attempted) and the ledger still holds exactly one effect",
      "scenario": "nc_ambiguous",
      "all": [
        {
          "obs": "nc_ambiguous.retry.status",
          "op": "eq",
