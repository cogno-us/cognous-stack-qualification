    {
      "id": "NC2-01",
      "mandatory": true,
      "title": "Ambiguous commit (lost acknowledgement): result is unknown, never acknowledged, retry not eligible",
      "scenario": "nc_ambiguous",
      "all": [
        {
          "obs": "nc_ambiguous.first.status",
          "op": "eq",
          "value": "unknown"
