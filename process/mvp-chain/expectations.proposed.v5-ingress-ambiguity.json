{
  "schema": "cognous.mvp-chain-expectations/1",
  "statuses": [
    "PASS",
    "FAIL",
    "BLOCKED",
    "NOT RUN",
    "NOT APPLICABLE"
  ],
  "semantics": {
    "NOT RUN": "the scenario produced no observation record at all",
    "BLOCKED": "the scenario or a precondition recorded that it could not be exercised (absent module, undefined differential); never a pass",
    "NOT APPLICABLE": "a declared not_applicable_if predicate held",
    "FAIL": "an observation contradicts a predicate, or a required observation is missing from a scenario that ran",
    "PASS": "every predicate held on the recorded raw observations; says nothing beyond the named row"
  },
  "operators": [
    "eq",
    "ne",
    "in",
    "not_in",
    "true",
    "false",
    "empty",
    "nonempty",
    "contains",
    "contains_all",
    "not_contains",
    "gte",
    "lte",
    "is_null"
  ],
  "status": "PROPOSED, NOT A FINAL VERSION: v3 plus the single row NC2-06 only. Qualification must compose the final expectations version from the NC4-03 row of PR #222 (branch nc4-03-dataflow-predicate-v4) and this NC2-06 row as a new frozen version; that composition is not done here. v1-v3 kept unchanged. Never edit after seeing results: a change is a new file with a recorded reason.",
  "supersedes": {
    "file": "expectations.proposed.v3.json (this file does NOT supersede or compete with PR #222's expectations.proposed.v4.json)",
    "reasons": {
      "NC2-06": "added (Architect ruling 5): one controlled owner-side fault-injection test through the REAL ingress producing an ambiguous acknowledgement; labelled supported-ingress evidence, distinct from the executor-level rows NC2-01..05 and test_ruling4_lost_ack.py."
    },
    "unchanged_rows": "all other rows are byte-identical to v3"
  },
  "rows": [
    {
      "id": "ENV-01",
      "mandatory": true,
      "title": "Every component HEAD equals its pin, checkouts pristine, modules loaded from the pinned trees, pydantic >= 2.12",
      "scenario": "env",
      "all": [
        {
          "obs": "env.pins_match",
          "op": "true"
        },
        {
          "obs": "env.pristine",
          "op": "true"
        },
        {
          "obs": "env.modules_from_pinned_trees",
          "op": "true"
        },
        {
          "obs": "env.pydantic_ok",
          "op": "true"
        }
      ]
    },
    {
      "id": "CHAIN-01",
      "mandatory": true,
      "title": "Control Plane decides authorized and the operation is admitted (operation identity, journal mode)",
      "scenario": "chain",
      "all": [
        {
          "obs": "chain.decision.result",
          "op": "eq",
          "value": "authorized"
        },
        {
          "obs": "chain.operation.status",
          "op": "eq",
          "value": "ok"
        },
        {
          "obs": "chain.operation.identity_profile_on",
          "op": "true"
        },
        {
          "obs": "chain.proposal.amount",
          "op": "eq",
          "value": 10.0
        }
      ]
    },
    {
      "id": "CHAIN-02",
      "mandatory": true,
      "title": "Real provision_local_execution_claim (executor.provision_claim) issues a claim",
      "scenario": "chain",
      "all": [
        {
          "obs": "chain.claim.ok",
          "op": "true"
        },
        {
          "obs": "chain.claim.state_after_provision",
          "op": "eq",
          "value": "issued"
        }
      ]
    },
    {
      "id": "CHAIN-03",
      "mandatory": true,
      "title": "Route B execute commits exactly one effect and consumes the claim (independent read-only ledger read)",
      "scenario": "chain",
      "all": [
        {
          "obs": "chain.execute.status",
          "op": "eq",
          "value": "executed"
        },
        {
          "obs": "chain.execute.observed_state",
          "op": "eq",
          "value": "applied"
        },
        {
          "obs": "chain.destination.effect_count",
          "op": "eq",
          "value": 1
        },
        {
          "obs": "chain.destination.claim_state_after",
          "op": "eq",
          "value": "consumed"
        },
        {
          "obs": "chain.destination.operation_identity_destination",
          "op": "true"
        }
      ]
    },
    {
      "id": "CHAIN-04",
      "mandatory": true,
      "title": "export_execution_artifacts serialises the executor evidence",
      "scenario": "chain",
      "all": [
        {
          "obs": "chain.export.ok",
          "op": "true"
        }
      ]
    },
    {
      "id": "CHAIN-05",
      "mandatory": true,
      "title": "Replay import accepts the raw CP record, proposal and executor export; all import reports complete",
      "scenario": "chain",
      "blocked_if": [
        {
          "obs": "chain.export.ok",
          "op": "false"
        }
      ],
      "all": [
        {
          "obs": "chain.replay.ok",
          "op": "true"
        },
        {
          "obs": "chain.replay.all_reports_complete",
          "op": "true"
        }
      ]
    },
    {
      "id": "CHAIN-06",
      "mandatory": true,
      "title": "Evidence Pack imports the Replay bundle and validate_evidence_pack is valid",
      "scenario": "chain",
      "blocked_if": [
        {
          "obs": "chain.replay.ok",
          "op": "false"
        }
      ],
      "all": [
        {
          "obs": "chain.pack.ok",
          "op": "true"
        },
        {
          "obs": "chain.pack.valid",
          "op": "true"
        }
      ]
    },
    {
      "id": "VER-01",
      "mandatory": true,
      "title": "Pinned Verifier on the raw CP record + proposal + manifest does not crash, does not refute (exit 0 accept or 3 abstain only)",
      "scenario": "chain",
      "all": [
        {
          "obs": "chain.verifier.A.crashed",
          "op": "false"
        },
        {
          "obs": "chain.verifier.A.exit_code",
          "op": "in",
          "value": [
            0,
            3
          ]
        },
        {
          "obs": "chain.verifier.A.refuted_check_ids",
          "op": "empty"
        }
      ]
    },
    {
      "id": "VER-02",
      "mandatory": true,
      "title": "No Verifier finding with code journal_check_reused (the documented claim-stage journal refutation)",
      "scenario": "chain",
      "all": [
        {
          "obs": "chain.verifier.A.finding_codes",
          "op": "not_contains",
          "value": "journal_check_reused"
        }
      ]
    },
    {
      "id": "VER-03",
      "mandatory": true,
      "title": "Verifier run B (record + proposal + manifest + harness-derived ledger): any abstention is attributable only to v4.ledger.rows-agree-with-attempts (route B has no attempt layer); no check refuted",
      "scenario": "chain",
      "not_applicable_if": [
        {
          "obs": "chain.verifier.B.exit_code",
          "op": "eq",
          "value": 0
        }
      ],
      "all": [
        {
          "obs": "chain.verifier.B.crashed",
          "op": "false"
        },
        {
          "obs": "chain.verifier.B.exit_code",
          "op": "eq",
          "value": 3
        },
        {
          "obs": "chain.verifier.B.could_not_check_check_ids",
          "op": "eq",
          "value": [
            "v4.ledger.rows-agree-with-attempts"
          ]
        },
        {
          "obs": "chain.verifier.B.refuted_check_ids",
          "op": "empty"
        }
      ]
    },
    {
      "id": "VER-04",
      "mandatory": true,
      "title": "Verifier exit code, report bytes (hash) and module path retained for the run",
      "scenario": "chain",
      "all": [
        {
          "obs": "chain.verifier.A.report_sha256",
          "op": "nonempty"
        },
        {
          "obs": "chain.verifier.A.module_path_under_pin",
          "op": "true"
        }
      ]
    },
    {
