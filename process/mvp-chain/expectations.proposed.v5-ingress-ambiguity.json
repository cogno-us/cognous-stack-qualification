    {
      "id": "NC1-04",
      "mandatory": true,
      "title": "Approval revocation is terminal: revoke, then reactivate the approval, then execute the claim issued earlier: refused, zero effects",
      "scenario": "nc_revocation",
      "all": [
        {
          "obs": "nc_revocation.approval_terminality.status",
          "op": "eq",
          "value": "denied"
        },
        {
          "obs": "nc_revocation.approval_terminality.effect_count",
          "op": "eq",
          "value": 0
        }
      ]
    },
    {
      "id": "NC1-05",
      "mandatory": true,
      "title": "Grant revocation is terminal: revoke, then reactivate the grant, then execute: refused, zero effects",
      "scenario": "nc_revocation",
      "all": [
        {
          "obs": "nc_revocation.grant_terminality.status",
